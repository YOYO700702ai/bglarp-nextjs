# Existing Notion catalog
NOTION_TOKEN=
DATABASE_ID=

# Supabase project values (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: set these in Vercel/local .env.local, never expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Script admin rollout. Keep `notion` until the Supabase import and acceptance
# checks are complete; switch deliberately to `supabase` at cutover.
SCRIPT_CATALOG_SOURCE=notion

# Server-only token used by the AI draft endpoints. Generate a long random
# value; never prefix it with NEXT_PUBLIC_ or expose it to browser code.
SCRIPT_ADMIN_AI_TOKEN=

# Optional: override these only if the existing Notion database uses different
# property names.
SCRIPT_NOTION_TITLE_PROPERTY=劇本名稱
SCRIPT_NOTION_SYNOPSIS_PROPERTY=劇情簡介
SCRIPT_NOTION_CHARACTERS_PROPERTY=角色
SCRIPT_NOTION_GENRES_PROPERTY=類型
SCRIPT_NOTION_CUSTOM_TAGS_PROPERTY=類型標籤
SCRIPT_NOTION_DURATION_PROPERTY=時長
SCRIPT_NOTION_PRICE_PROPERTY=價格
SCRIPT_NOTION_PLAYERS_PROPERTY=人數
